<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/imgDialogNews"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:src="@drawable/general"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="News Title"
                android:textColor="@android:color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvDialogDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This is a detailed description of the news item. It contains more information than the list item."
                android:textColor="#333333"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp"/>

            <Button
                android:id="@+id/btnViewArticle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="View Full Article"
                app:cornerRadius="14dp"
                android:textColor="@android:color/white"
                android:backgroundTint="#222222"
                android:textAllCaps="true" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
